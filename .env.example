# ==============================================================================
# SehatSetu Environment Configuration Template
# ==============================================================================

# Django Secret Key & Debug Mode
DEBUG=False
SECRET_KEY=django-insecure-prod-key-change-this-in-production-environment-2026

# Hostnames & CORS Origins (No wildcard * in production)
ALLOWED_HOSTS=localhost,127.0.0.1,sehatsetu.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sehatsetu.com

# PostgreSQL Database Connection
# Format: postgres://username:password@hostname:port/database_name
DATABASE_URL=postgres://sehatsetu_user:sehatsetu_pass_secure_2026@postgres:5432/sehatsetu_db

# Redis Connection (Channel Layers & Celery Broker)
# Format: redis://hostname:port/db_index
REDIS_URL=redis://redis:6379/0

# Transactional Email Gateway (SMTP Configuration)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key_here
DEFAULT_FROM_EMAIL=SehatSetu Care <notifications@sehatsetu.com>

# JWT Authentication Token Lifetimes
SIMPLE_JWT_ACCESS_MINUTES=60
SIMPLE_JWT_REFRESH_DAYS=7

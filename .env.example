# ==========================================
# SehatSetu Environment Configuration Template
# ==========================================

# --- Django Backend ---
SECRET_KEY=change-me-to-a-secure-production-secret-key-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# --- Database (PostgreSQL) ---
POSTGRES_DB=sehatsetu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sehatsetu

# --- Redis (Broker & Channels) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS Settings ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
